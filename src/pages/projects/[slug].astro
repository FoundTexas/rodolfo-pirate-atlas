---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import WebsiteShowcase from '../../components/WebsiteShowcase.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((entry) => entry.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---
<BaseLayout title={`${project.title} — Rodolfo León`} description={project.summary}>
  <SiteHeader />
  <main id="main-content" class="case-study" style={`--case-accent:${project.color}`}>
    <section class="case-hero">
      <div class="case-orbit" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
      <div class="container-xxl px-4 case-hero-content">
        <a class="back-link" href="/#work">← Return to selected work</a>
        <div class="case-meta d-flex flex-wrap gap-3 justify-content-between"><span>{project.eyebrow}</span><span>{project.year}</span></div>
        <h1>{project.title}</h1>
        <p>{project.summary}</p>
        <div class="case-stack d-flex flex-wrap gap-2">
          {project.stack.map((item: string) => <span class="badge rounded-pill">{item}</span>)}
        </div>
      </div>
    </section>

    {project.websites && (
      <section class="container-xxl px-4 pt-5" aria-labelledby="websites-title">
        <div class="row align-items-end g-4 mb-4">
          <div class="col-lg-7">
            <p class="section-index">Live websites</p>
            <h2 id="websites-title">Open the work directly.</h2>
          </div>
          <div class="col-lg-5"><p class="mb-0 text-secondary-emphasis">Each card links to the deployed project and uses a live generated preview when available.</p></div>
        </div>
        <WebsiteShowcase websites={project.websites} />
      </section>
    )}

    {project.previewUrl && !project.websites && (
      <section class="case-preview container-xxl px-4" aria-label={`Live preview of ${project.title}`}>
        <a href={project.previewUrl} target="_blank" rel="noreferrer">
          <ProjectPreview title={project.title} url={project.previewUrl} color={project.color} index={currentIndex} visual={project.visual} />
          <span>Open live project ↗</span>
        </a>
      </section>
    )}

    {project.visual && project.visual !== 'default' && !project.previewUrl && !project.websites && (
      <section class="case-preview case-concept-preview container-xxl px-4" aria-label={`Conceptual visual for ${project.title}`}>
        <div class="rounded-4 overflow-hidden shadow-lg">
          <ProjectPreview title={project.title} color={project.color} index={currentIndex} visual={project.visual} />
          <p class="case-concept-caption mb-0">Conceptual portfolio view · no proprietary screens or customer data shown.</p>
        </div>
      </section>
    )}

    <section class="container-xxl px-4 section-pad">
      <div class="row g-5 case-body-bootstrap">
        <aside class="col-lg-3 case-sidebar">
          <div class="position-sticky" style="top: 110px;">
            <img class="case-panda mb-4" src="/profile-panda-transparent.svg" alt="" width="92" height="92" />
            <dl class="mb-4">
              <dt>Territory</dt>
              <dd>{project.category}</dd>
              <dt>Period</dt>
              <dd>{project.year}</dd>
            </dl>
            {project.links && project.links.length > 0 && !project.websites && (
              <div class="list-group case-link-list">
                {project.links.map((link) => (
                  <a class="list-group-item list-group-item-action" href={link.url} target="_blank" rel="noreferrer">{link.label} <span>↗</span></a>
                ))}
              </div>
            )}
          </div>
        </aside>

        <div class="col-lg-9 case-content">
          {project.confidentiality && <div class="alert case-note" role="note"><strong>Disclosure:</strong> {project.confidentiality}</div>}

          <div class="case-block">
            <p class="section-index">The challenge</p>
            <h2>What needed to change</h2>
            <p>{project.challenge}</p>
          </div>

          <div class="case-block">
            <p class="section-index">The route</p>
            <h2>How I approached it</h2>
            <ol class="list-group list-group-numbered approach-list">
              {project.approach.map((item: string) => (
                <li class="list-group-item d-flex gap-3 align-items-start"><p class="mb-0">{item}</p></li>
              ))}
            </ol>
          </div>

          <div class="case-block result-block card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <p class="section-index">Landfall</p>
              <h2>Result</h2>
              <p class="mb-0">{project.result}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <a class="next-project d-block" href={`/projects/${nextProject.slug}/`}>
      <div class="container-xxl px-4 d-flex align-items-center justify-content-between gap-4">
        <div><span>Continue the voyage</span><strong>{nextProject.title}</strong></div>
        <b>↗</b>
      </div>
    </a>
  </main>
  <footer class="site-footer container-xxl px-4"><p class="mb-0">Rodolfo León · The Builder's Atlas</p></footer>
</BaseLayout>
