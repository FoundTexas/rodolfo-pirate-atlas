---
const pageTitle = 'Rodolfo León | Digital Card';
const description =
  'Digital business card for Rodolfo León, Technical Consultant and Software Engineer.';

const projects = [
  {
    name: 'Twinly Petwear',
    label: 'Web Catalog',
    description: 'Personalized petwear experience.',
    href: 'https://twinly-petwear.vercel.app/',
    mark: 'TW',
  },
  {
    name: 'ADI',
    label: 'Web Catalog',
    description: 'Online commercial catalog.',
    href: 'https://adi.foundtexas.net/',
    mark: 'AD',
  },
  {
    name: 'Cacao Finca 17',
    label: 'Brand site',
    description: 'Storytelling and product landing page.',
    href: 'https://cacao-finca-17.vercel.app/',
    mark: '17',
  },
  {
    name: 'Óptimo Ópticas',
    label: 'E-comerce',
    description: 'Responsive commercial experience.',
    href: 'https://optimoopticas.mx/',
    mark: 'ÓP',
  },
  {
    name: 'Masoftcode',
    label: 'Brand site',
    description: 'Services and client delivery.',
    href: 'https://masoftcode.com/',
    mark: 'MS',
  },
  {
    name: 'FoundTexas',
    label: 'Games',
    description: 'Playable interactive experiments.',
    href: 'https://foundtexas.itch.io/',
    mark: 'FT',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061820" />
    <title>{pageTitle}</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <style is:global>
      :root {
        color-scheme: dark;
        --ink: #f4fbf9;
        --muted: #a9bfbd;
        --ocean: #061820;
        --ocean-deep: #020b10;
        --surface: rgba(8, 30, 39, 0.9);
        --surface-raised: rgba(14, 42, 52, 0.82);
        --surface-soft: rgba(255, 255, 255, 0.055);
        --line: rgba(165, 224, 210, 0.16);
        --line-strong: rgba(120, 217, 189, 0.42);
        --sand: #edcf98;
        --mint: #78d9bd;
        --mint-bright: #9de9d4;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        background: var(--ocean-deep);
      }

      body {
        min-height: 100vh;
        margin: 0;
        color: var(--ink);
        background:
          radial-gradient(circle at 14% 10%, rgba(120, 217, 189, 0.2), transparent 22rem),
          radial-gradient(circle at 88% 86%, rgba(237, 207, 152, 0.13), transparent 25rem),
          linear-gradient(150deg, #08242f 0%, var(--ocean) 45%, var(--ocean-deep) 100%);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.28;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 1px);
        background-size: 38px 38px;
        mask-image: linear-gradient(to bottom, black, transparent 90%);
      }

      .page-wrap {
        position: relative;
        z-index: 1;
      }

      .card-shell {
        width: min(100%, 1000px);
        border: 1px solid var(--line);
        background: linear-gradient(145deg, rgba(8, 31, 40, 0.96), rgba(4, 19, 27, 0.92));
        box-shadow: 0 36px 110px rgba(0, 0, 0, 0.46);
        backdrop-filter: blur(20px);
      }

      .identity-block {
        position: relative;
      }

      .avatar-frame {
        position: relative;
        width: 126px;
        height: 126px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 2rem;
        background:
          linear-gradient(145deg, rgba(120, 217, 189, 0.22), rgba(237, 207, 152, 0.12));
        border: 1px solid rgba(157, 233, 212, 0.26);
        box-shadow:
          0 18px 35px rgba(0, 0, 0, 0.32),
          inset 0 1px 0 rgba(255, 255, 255, 0.12);
      }

      .avatar-frame::after {
        content: "";
        position: absolute;
        inset: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.55rem;
        pointer-events: none;
        overflow: hidden;
      }

      .profile-photo {
        width: 112px;
        height: 112px;
        object-fit: contain;
        background: transparent;
        filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.3));
      }

      .eyebrow {
        color: var(--mint-bright);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-size: 0.72rem;
        font-weight: 750;
      }

      .identity-title {
        letter-spacing: -0.035em;
      }

      .lead-copy {
        color: var(--muted);
        max-width: 43rem;
        line-height: 1.58;
      }

      .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: #c9d9d6;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.045);
        font-size: 0.78rem;
      }

      .meta-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: var(--mint);
        box-shadow: 0 0 0 4px rgba(120, 217, 189, 0.1);
      }

      .section-label {
        color: #d9e9e5;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .skill-badge {
        color: #d9e8e5;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.055);
        font-weight: 550;
        font-size: 0.78rem;
      }

      .qr-panel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line-strong);
        background:
          radial-gradient(circle at 50% 10%, rgba(120, 217, 189, 0.12), transparent 50%),
          rgba(1, 11, 16, 0.62);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }

      .qr-panel::before {
        content: "PORTFOLIO PASS";
        display: inline-flex;
        margin-bottom: 0.8rem;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        color: var(--mint-bright);
        border: 1px solid rgba(120, 217, 189, 0.24);
        background: rgba(120, 217, 189, 0.07);
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.18em;
      }

      .qr-code {
        min-height: 210px;
        display: grid;
        place-items: center;
      }

      .qr-code img,
      .qr-code canvas {
        display: block;
        max-width: 100%;
        height: auto;
        border: 10px solid white;
        border-radius: 1.2rem;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.34);
      }

      .qr-caption {
        color: #e5f1ee;
      }

      .qr-target {
        color: #77918d;
      }

      .action-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.65rem;
      }

      .action-grid .btn-primary {
        grid-column: 1 / -1;
      }

      .btn {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .btn-primary {
        --bs-btn-bg: var(--mint);
        --bs-btn-border-color: var(--mint);
        --bs-btn-color: #05201a;
        --bs-btn-hover-bg: var(--mint-bright);
        --bs-btn-hover-border-color: var(--mint-bright);
        --bs-btn-hover-color: #05201a;
        --bs-btn-active-bg: var(--mint-bright);
        --bs-btn-active-border-color: var(--mint-bright);
        font-weight: 760;
        box-shadow: 0 10px 24px rgba(120, 217, 189, 0.18);
      }

      .btn-outline-light {
        --bs-btn-color: #dce9e6;
        --bs-btn-border-color: rgba(255, 255, 255, 0.2);
        --bs-btn-hover-bg: rgba(255, 255, 255, 0.08);
        --bs-btn-hover-border-color: rgba(120, 217, 189, 0.42);
        --bs-btn-hover-color: white;
      }

      .project-card,
      .contact-card {
        min-height: 100%;
        color: var(--ink);
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.045);
        transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
      }

      .project-card:hover,
      .project-card:focus-visible,
      .contact-card:hover,
      .contact-card:focus-visible {
        color: var(--ink);
        transform: translateY(-3px);
        border-color: rgba(120, 217, 189, 0.5);
        background: rgba(120, 217, 189, 0.08);
      }

      .project-mark {
        width: 2.35rem;
        height: 2.35rem;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border-radius: 0.85rem;
        color: #08231e;
        background: linear-gradient(145deg, var(--mint-bright), var(--sand));
        font-size: 0.68rem;
        font-weight: 850;
        letter-spacing: 0.04em;
      }

      .project-card small,
      .contact-card small {
        color: var(--muted);
      }

      .project-tag {
        color: var(--mint-bright) !important;
        font-size: 0.66rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        font-weight: 750;
      }

      .aside-panel {
        background: rgba(1, 12, 17, 0.28);
      }

      .tiny {
        color: var(--muted);
        font-size: 0.76rem;
      }

      @media (max-width: 767.98px) {
        body {
          background:
            radial-gradient(circle at 50% 0%, rgba(120, 217, 189, 0.18), transparent 22rem),
            linear-gradient(180deg, #08232d 0%, #05151d 52%, #020a0f 100%);
        }

        .page-wrap {
          padding: 0.85rem !important;
        }

        .card-shell {
          border-radius: 1.45rem !important;
          overflow: hidden;
        }

        .main-section {
          padding: 1.2rem !important;
        }

        .identity-block {
          text-align: center;
          padding: 0.35rem 0.25rem 0.2rem;
        }

        .identity-block .d-flex {
          align-items: center !important;
        }

        .avatar-frame {
          width: 112px;
          height: 112px;
          border-radius: 1.75rem;
        }

        .avatar-frame::after {
          border-radius: 1.35rem;
          overflow: hidden;
        }

        .profile-photo {
          width: 100px;
          height: 100px;
        }

        .identity-title {
          font-size: clamp(2rem, 9vw, 2.55rem);
          line-height: 1;
        }

        .lead-copy {
          margin-inline: auto;
          font-size: 1rem !important;
          line-height: 1.52;
          max-width: 34rem;
        }

        .meta-row {
          justify-content: center;
        }

        .mobile-qr {
          margin-top: 1.3rem;
          padding: 1.1rem !important;
          border-radius: 1.3rem !important;
        }

        .mobile-qr .qr-code {
          min-height: 184px;
        }

        .mobile-qr .qr-code img,
        .mobile-qr .qr-code canvas {
          width: 184px !important;
          height: 184px !important;
          border-width: 9px;
          border-radius: 1rem;
        }

        .skills-wrap {
          padding: 0.25rem 0;
        }

        .skills-list {
          justify-content: center;
        }

        .skill-badge {
          padding: 0.5rem 0.8rem !important;
        }

        .action-grid .btn {
          padding-inline: 0.8rem !important;
          font-size: 0.9rem;
        }

        .selected-work {
          margin-top: 2rem !important;
        }

        .project-card {
          padding: 0.85rem !important;
          border-radius: 1rem !important;
        }

        .project-card strong {
          font-size: 0.92rem;
          line-height: 1.15;
        }

        .project-card .description {
          display: none !important;
        }

        .project-mark {
          width: 2.1rem;
          height: 2.1rem;
          border-radius: 0.75rem;
        }

        .aside-panel {
          border-top: 1px solid var(--line);
          border-left: 0 !important;
          padding: 1.2rem !important;
        }

        .contact-grid {
          display: grid !important;
          grid-template-columns: 1fr 1fr;
          gap: 0.65rem !important;
        }

        .contact-grid .contact-card:last-child {
          grid-column: 1 / -1;
        }

        .contact-card {
          padding: 0.85rem !important;
          border-radius: 1rem !important;
          min-width: 0;
        }

        .contact-card strong {
          font-size: 0.83rem;
          word-break: break-word;
        }
      }

      @media (max-width: 380px) {
        .page-wrap {
          padding: 0 !important;
        }

        .card-shell {
          border-radius: 0 !important;
          border-inline: 0;
        }

        .main-section,
        .aside-panel {
          padding-inline: 1rem !important;
        }

        .mobile-qr .qr-code img,
        .mobile-qr .qr-code canvas {
          width: 170px !important;
          height: 170px !important;
        }
      }

      @media print {
        body {
          background: white;
          color: black;
        }

        body::before,
        .no-print {
          display: none !important;
        }

        .card-shell,
        .aside-panel {
          color: black;
          border-color: #d9d9d9;
          background: white;
          box-shadow: none;
          backdrop-filter: none;
        }

        .lead-copy,
        .tiny,
        .project-card small,
        .contact-card small {
          color: #444 !important;
        }

        .project-card,
        .contact-card,
        .qr-panel,
        .skill-badge {
          color: black;
          border-color: #d9d9d9;
          background: white;
        }
      }
    </style>
  </head>

  <body>
    <main class="page-wrap container py-4 py-lg-5">
      <article class="card-shell mx-auto rounded-5 overflow-hidden">
        <div class="row g-0">
          <section class="main-section col-lg-8 p-4 p-md-5">
            <div class="identity-block mb-4">
              <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 gap-md-4">
                <div class="avatar-frame">
                  <img
                    class="profile-photo"
                    src="/profile-photo.png"
                    alt="Portrait of Rodolfo León"
                    width="112"
                    height="112"
                  />
                </div>

                <div class="flex-grow-1">
                  <p class="eyebrow mb-2">Technical Consultant · Software Engineer</p>
                  <h1 class="identity-title display-5 fw-bold mb-3">Rodolfo León</h1>
                  <p class="lead-copy fs-5 mb-3">
                    I build systems people can use, understand and sometimes play—from data platforms
                    and cloud-native backends to web products and interactive worlds.
                  </p>
                  <div class="meta-row d-flex flex-wrap gap-2">
                    <span class="meta-pill rounded-pill px-3 py-2">
                      <span class="meta-dot" aria-hidden="true"></span>
                      Mexico City
                    </span>
                    <span class="meta-pill rounded-pill px-3 py-2">English · Spanish</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="mobile-qr qr-panel rounded-4 p-3 text-center mb-4 d-lg-none">
              <div class="qr-code" data-qr-code aria-label="QR code linking to the portfolio homepage"></div>
              <p class="qr-caption small fw-semibold mt-3 mb-1">Scan to open the full portfolio</p>
              <p class="qr-target tiny text-break mb-0"></p>
            </div>

            <div class="skills-wrap mb-4">
              <p class="section-label mb-3">Core stack</p>
              <div class="skills-list d-flex flex-wrap gap-2">
                <span class="badge rounded-pill skill-badge px-3 py-2">SAS Viya</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">AWS</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">.NET</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">Python</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">Astro</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">Three.js</span>
                <span class="badge rounded-pill skill-badge px-3 py-2">Unity</span>
              </div>
            </div>

            <div class="action-grid mb-4 mb-md-5 no-print">
              <a id="portfolio-button" class="btn btn-primary rounded-pill px-4" href="/">
                Open portfolio
              </a>
              <button id="share-button" class="btn btn-outline-light rounded-pill px-4" type="button">
                Share card
              </button>
              <a class="btn btn-outline-light rounded-pill px-4" href="mailto:rolega01@gmail.com">
                Email me
              </a>
            </div>

            <div class="selected-work mt-4">
              <div class="d-flex align-items-end justify-content-between gap-3 mb-3">
                <div>
                  <p class="section-label mb-1">Selected work</p>
                  <h2 class="h4 mb-0">Projects worth exploring</h2>
                </div>
                <a class="tiny text-decoration-none d-none d-sm-inline" href="/">View all →</a>
              </div>

              <div class="row row-cols-2 g-2 g-md-3">
                {projects.map((project) => (
                  <div class="col">
                    <a
                      class="project-card d-flex align-items-start gap-2 gap-md-3 rounded-4 p-3 text-decoration-none"
                      href={project.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <span class="project-mark" aria-hidden="true">{project.mark}</span>
                      <span class="min-w-0">
                        <small class="project-tag d-block mb-1">{project.label}</small>
                        <strong class="d-block">{project.name}</strong>
                        <small class="description d-block mt-1">{project.description}</small>
                      </span>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <aside class="aside-panel col-lg-4 border-start border-light border-opacity-10 p-4 p-md-5 d-flex flex-column justify-content-between gap-4">
            <div class="qr-panel rounded-4 p-3 text-center d-none d-lg-block">
              <div class="qr-code" data-qr-code aria-label="QR code linking to the portfolio homepage"></div>
              <p class="qr-caption small fw-semibold mt-3 mb-1">Scan to open the full portfolio</p>
              <p class="qr-target tiny text-break mb-0"></p>
            </div>

            <div>
              <p class="section-label mb-3">Contact</p>
              <div class="contact-grid d-grid gap-2">
                <a class="contact-card rounded-4 p-3 text-decoration-none" href="mailto:rolega01@gmail.com">
                  <small>Email</small>
                  <strong class="d-block">rolega01@gmail.com</strong>
                </a>
                <a class="contact-card rounded-4 p-3 text-decoration-none" href="tel:+525549138324">
                  <small>Phone</small>
                  <strong class="d-block">+52 55 4913 8324</strong>
                </a>
                <div class="contact-card rounded-4 p-3">
                  <small>Based in</small>
                  <strong class="d-block">Mexico City, Mexico</strong>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </article>
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <script is:inline>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const overrideUrl = params.get('url');
        const portfolioUrl = overrideUrl || `${window.location.origin}/`;

        const targets = document.querySelectorAll('.qr-target');
        const portfolioButton = document.getElementById('portfolio-button');
        const qrContainers = document.querySelectorAll('[data-qr-code]');
        const shareButton = document.getElementById('share-button');

        targets.forEach((target) => {
          target.textContent = portfolioUrl;
        });
        if (portfolioButton) portfolioButton.setAttribute('href', portfolioUrl);

        const getQrSize = () => {
          if (window.innerWidth <= 380) return 170;
          if (window.innerWidth < 992) return 184;
          return 210;
        };

        qrContainers.forEach((qrContainer) => {
          if (window.QRCode) {
            qrContainer.innerHTML = '';
            const size = getQrSize();
            new window.QRCode(qrContainer, {
              text: portfolioUrl,
              width: size,
              height: size,
              colorDark: '#071a24',
              colorLight: '#ffffff',
              correctLevel: window.QRCode.CorrectLevel.H,
            });
          } else {
            qrContainer.innerHTML = '<a href="' + portfolioUrl + '">Open portfolio</a>';
          }
        });

        shareButton?.addEventListener('click', async () => {
          const shareData = {
            title: 'Rodolfo León — Portfolio',
            text: 'Technical Consultant and Software Engineer.',
            url: portfolioUrl,
          };

          try {
            if (navigator.share) {
              await navigator.share(shareData);
              return;
            }

            await navigator.clipboard.writeText(portfolioUrl);
            const original = shareButton.textContent;
            shareButton.textContent = 'Link copied';
            window.setTimeout(() => {
              shareButton.textContent = original;
            }, 1800);
          } catch (error) {
            console.warn('Unable to share the card.', error);
          }
        });
      })();
    </script>
  </body>
</html>
